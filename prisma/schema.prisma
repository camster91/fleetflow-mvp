// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // Nullable for OAuth users
  role          String    @default("fleet_manager")
  driverLicense String?
  licenseExpiry DateTime?
  availabilityStatus String? @default("Available")
  company       String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Email verification
  verificationToken String? @unique

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  backupCodes      String? // Hashed backup codes, JSON array
  lastTotpStep     Int?    // Last accepted TOTP time step; rejects code replay

  // Password reset
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  passwordChangedAt    DateTime? // used to invalidate JWTs issued before password change
  tokenVersion         Int       @default(0) // bumped to revoke every issued session JWT

  // Login tracking
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Social auth
  googleId    String? @unique
  microsoftId String? @unique

  // IANA time zone for the personal workspace's server-side "today"
  timeZone String @default("America/Toronto")

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Notification preferences (JSON string)
  notificationPreferences String? @default("{}")

  // Session management
  sessions Session[]
  accounts Account[]

  // Login history for security audit
  loginHistory LoginHistory[]
  passwordHistory PasswordHistory[]

  // Teams - User can own multiple teams and be member of multiple teams
  ownedTeams Team[]
  teamMemberships TeamMember[]

  // Notifications
  notifications Notification[]

  // API Keys
  apiKeys ApiKey[]

  // Subscription
  subscription Subscription?
  invoices Invoice[]

  // User data (vehicles, deliveries, etc.)
  userData UserData[]
  
  // Owned business data
  vehicles Vehicle[]
  deliveries Delivery[]
  assignedVehicles Vehicle[] @relation("VehicleAssignedDriver")
  assignedDeliveries Delivery[] @relation("DeliveryAssignedDriver")
  maintenanceTasks MaintenanceTask[]
  clients Client[]
  sopCategories SOPCategory[]
  vendingMachines VendingMachine[]
  announcements   Announcement[]
  taskShareLinks TaskShareLink[]
  intelligenceFindings IntelligenceFinding[]
    intelligenceRuns IntelligenceRun[]
    ownedMaintenanceRiskFeedback MaintenanceRiskFeedback[] @relation("MaintenanceRiskFeedbackOwner")
    submittedMaintenanceRiskFeedback MaintenanceRiskFeedback[] @relation("MaintenanceRiskFeedbackSubmitter")
  documents DocumentUpload[] @relation("DocumentOwner")
  uploadedDocuments DocumentUpload[] @relation("DocumentUploader")
  confirmedDocumentExecutions DocumentExecution[] @relation("DocumentConfirmer")
  expenses ExpenseRecord[]
  integrationConnections IntegrationConnection[]

  @@index([email])
  @@index([googleId])
  @@index([microsoftId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // Track device info for session management
  deviceInfo   String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Login history for security audit trail
model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?
  success   Boolean
  failureReason String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([userId, timestamp])
}

// Password history to prevent reuse
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  password  String   // Hashed password
  createdAt DateTime @default(now())

  @@index([userId])
}

// Team Management
model Team {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  
  // Relationships to team data
  vehicles     Vehicle[]
  deliveries   Delivery[]
  maintenanceTasks MaintenanceTask[]
  clients      Client[]
  sopCategories SOPCategory[]
  vendingMachines VendingMachine[]
  announcements   Announcement[]
  intelligenceFindings IntelligenceFinding[]
    intelligenceRuns IntelligenceRun[]
    maintenanceRiskFeedback MaintenanceRiskFeedback[]
  documents DocumentUpload[]
  expenses ExpenseRecord[]
  integrationConnections IntegrationConnection[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Company info
  logo          String?
  address       String?
  phone         String?
  businessHours String?
  branding      String?  // Custom colors, etc. (JSON string)
  timeZone      String   @default("America/Toronto") // IANA zone for server-side "today"

  @@index([ownerId])
}

model TeamMember {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?  // null until invite accepted for brand-new users
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteeEmail String?  // intended recipient when userId is not yet known
  role         String   @default("MEMBER") // OWNER, ADMIN, MANAGER, MEMBER, VIEWER
  invitedBy    String?
  invitedAt    DateTime @default(now())
  joinedAt     DateTime?
  status       String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([inviteeEmail])
}

// Notifications System
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // MAINTENANCE_DUE, VEHICLE_ALERT, TEAM_INVITE, BILLING, SYSTEM, SECURITY
  title       String
  message     String
  data        String?  // Flexible data storage (JSON string)
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

// API Keys for integrations
model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  key         String   @unique
  scopes      String   @default("")
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([userId])
}

model ApiRateLimit {
  keyId       String
  bucketStart DateTime
  count       Int      @default(0)

  @@id([keyId, bucketStart])
  @@index([bucketStart])
}

// Subscription & Billing Models
model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  plan                  String    @default("PER_USER") // PER_USER, UNLIMITED
  status                String    @default("TRIAL")   // TRIAL, ACTIVE, CANCELLED, PAST_DUE, UNPAID
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  stripeLastEventId     String?
  stripeLastEventCreated Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeInvoiceId String   @unique
  amount          Int      // Stripe minor units (for example cents)
  currency        String   @default("USD")
  status          String
  invoicePdf      String?
  createdAt       DateTime @default(now())
  periodStart     DateTime
  periodEnd       DateTime

  @@index([userId])
  @@index([stripeInvoiceId])
  @@index([createdAt])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model IntelligenceFinding {
  id          String   @id
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type        String
  severity    String
  confidence  Float
  score       Int
  ruleVersion String
  title       String
  explanation String
  evidence    String
  action      String?
  actionUrl   String?
  status      String   @default("OPEN")
  feedback    String?
  generatedAt DateTime @default(now())
  expiresAt   DateTime?
  resolvedAt  DateTime?

  @@index([ownerId, teamId, status, severity])
  @@index([ownerId, teamId, score(sort: Desc), id])
  @@index([ownerId, teamId, status, score(sort: Desc), id])
  @@index([expiresAt])
}

model IntelligenceRun {
  id                     String   @id
  ownerId                String
  owner                  User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId                 String?
  team                   Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  generatedAt            DateTime @default(now())
  sourceComplete         Boolean
  findingsComplete       Boolean
  reconciliationComplete Boolean
  evidenceComplete       Boolean
  findingTotal           Int
  sourceCounts           String

  @@index([ownerId, teamId])
  @@index([generatedAt])
}

model MaintenanceRiskFeedback {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation("MaintenanceRiskFeedbackOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rubricVersion   String
  scoreSnapshot   Int
  bandSnapshot    String
  sourceComplete  Boolean
  completenessPercent Int
  helpful         Boolean
  actionTaken     Boolean
  outcomeCategory String?
  notes           String?
  consentedAt     DateTime
  submittedById   String
  submittedBy     User     @relation("MaintenanceRiskFeedbackSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  scopeKey        String
  idempotencyKey  String
  requestHash     String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([submittedById, scopeKey, idempotencyKey], map: "MaintenanceRiskFeedback_submit_scope_idem_key")
  @@index([ownerId, teamId, vehicleId, createdAt])
  @@index([rubricVersion, createdAt])
  @@index([submittedById, createdAt])
  @@index([expiresAt])
}

// Stored create responses for Idempotency-Key replay (lib/idempotency.ts).
// Rows expire after 24 hours and are removed by /api/cron/cleanup-audit-logs.
model IdempotencyKey {
  id           String   @id @default(cuid())
  scope        String
  userId       String
  key          String
  route        String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

// Core Business Models
model Vehicle {
  id              String   @id @default(cuid())
  name            String
  status          String   @default("active") // active, inactive, delayed
  driver          String?
  assignedDriverId String?
  assignedDriver User? @relation("VehicleAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  location        String?
  eta             String?
  mileage         Int?     @default(0)
  maintenanceDue  Boolean  @default(false)
  
  // Vehicle details
  vehicleType     String?
  licensePlate    String?
  year            Int?
  fuelLevel       Int?     @default(100) // percentage
  lastService     DateTime?
  nextService     DateTime?
  
  // Relationships
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  
  // Related data
  deliveries      Delivery[]
  maintenanceTasks MaintenanceTask[]
    expenses ExpenseRecord[]
    maintenanceRiskFeedback MaintenanceRiskFeedback[]
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastUpdated     DateTime @default(now())
  
  // Indexes
  @@index([ownerId])
  @@index([teamId])
  @@index([status])
  @@index([status, createdAt])
  @@index([maintenanceDue])
  @@index([assignedDriverId])
}

model Delivery {
  id                String   @id @default(cuid())
  address           String
  customer          String
  status            String   @default("pending") // pending, in-transit, delivered, cancelled
  driver            String?
  assignedDriverId  String?
  assignedDriver    User? @relation("DeliveryAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  items             Int      @default(1)
  progress          Int      @default(0) // percentage
  
  // Timestamps
  scheduledTime     DateTime?
  estimatedArrival  DateTime?
  completedTime     DateTime?
  
  // Location details
  parkingInstructions String?
  dropoffInstructions String?
  
  // Contact information (JSON string)
  contactPerson      String?  // JSON string: ContactPerson

  // Access information (JSON string)
  accessCodes        String?  // JSON string: string[]
  securityNotes      String?
  businessHours      String?
  specialRequirements String? // JSON string: string[]
  
  // Notes
  notes             String?
  
  // Relationships
  vehicleId         String?
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Location coordinates (JSON string)
  parkingLocation   String?  // JSON string: LocationCoordinates
  dropoffLocation   String?  // JSON string: LocationCoordinates

  // Photos (JSON string)
  photos            String?  // JSON string: DeliveryPhoto[]
  
  // Events
  events          DeliveryEvent[]

  // Indexes
  @@index([ownerId])
  @@index([teamId])
  @@index([vehicleId])
  @@index([status])
  @@index([status, createdAt])
  @@index([customer])
  @@index([createdAt])
  @@index([assignedDriverId])
}

model DeliveryEvent {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     String
  timestamp  DateTime @default(now())
  notes      String?
  latitude   Float?
  longitude  Float?
  createdBy  String?

  @@index([deliveryId])
  @@index([timestamp])
}

model MaintenanceTask {
  id                String   @id @default(cuid())
  title             String
  type              String
  vehicleName       String?  // denormalized vehicle name for display
  dueDate           DateTime
  priority          String   @default("medium") // high, medium, low
  completed         Boolean  @default(false)
  completedDate     DateTime?
  reminderSentAt    DateTime? // "due soon" reminder
  overdueReminderSentAt DateTime? // one-time overdue reminder (separate so a due-day reminder does not suppress it)

  // Details
  notes             String?
  estimatedDuration String?
  serviceProvider   String?
  costEstimate      Float?
  actualCost        Float?
  
  // Relationships
  vehicleId         String?  // optional FK to Vehicle
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  shareLinks        TaskShareLink[]
  
  // Parts needed (JSON string)
  partsNeeded       String?  // JSON string: string[]
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Indexes
  @@index([ownerId])
  @@index([teamId])
  @@index([vehicleId])
  @@index([priority])
  @@index([dueDate])
  @@index([completed])
  @@index([completed, dueDate])
}

model Client {
  id                String   @id @default(cuid())
  name              String
  businessName      String?
  type              String   @default("other") // restaurant, hotel, office, retail, warehouse, cafe, institution, other
  address           String
  
  // Contact information
  phone             String?
  email             String?
  website           String?
  
  // Delivery preferences
  businessHours     String?
  securityNotes     String?
  
  // Notes and history
  notes             String?
  lastDeliveryDate  DateTime?
  deliveryFrequency String?  // daily, weekly, bi-weekly, monthly, as-needed
  rating            Int?     @default(5) // 1-5
  
  // Relationships
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  
  // Contact person (JSON string)
  contactPerson     String?  // JSON string: ContactPerson

  // Preferences (JSON string)
  preferredDeliveryTimes String?  // JSON string: string[]
  accessCodes            String?  // JSON string: string[]
  specialRequirements    String?  // JSON string: string[]

  // Location data (JSON string)
  primaryLocation   String?  // JSON string: LocationCoordinates
  parkingLocation   String?  // JSON string: LocationCoordinates
  dropoffLocation   String?  // JSON string: LocationCoordinates
  
  // Instructions
  parkingInstructions  String?
  dropoffInstructions  String?
  
  // Photos (JSON string)
  locationPhotos    String?  // JSON string: DeliveryPhoto[]
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Indexes
  @@index([ownerId])
  @@index([teamId])
  @@index([type])
  @@index([name])
}

model SOPCategory {
  id                String   @id @default(cuid())
  name              String
  description       String?
  
  // Relationships
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  
  // Count (denormalized for performance)
  documentCount     Int      @default(0)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastUpdated       DateTime @default(now())
  
  // Indexes
  @@index([ownerId])
  @@index([teamId])
  @@index([name])
}

model VendingMachine {
  id                String   @id @default(cuid())
  name              String
  location          String
  status            String   @default("active") // active, maintenance, out-of-service
  lastService       DateTime?
  nextService       DateTime?
  
  // Details
  machineType       String?
  serialNumber      String?
  notes             String?
  
  // Relationships
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  
  // Notes (JSON string)
  driverNotes       String?  // JSON string: VendingMachineNote[]
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Indexes
  @@index([ownerId])
  @@index([teamId])
  @@index([status])
  @@index([location])
}

// Simple key-value store for user data (temporary solution for persistence)
model UserData {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataType          String   // 'vehicles', 'deliveries', 'maintenance', 'clients', 'sop', 'vending-machines'
  data              String   // JSON string of the data
  version           Int      @default(1)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Unique constraint: one data type per user
  @@unique([userId, dataType])
  
  // Indexes
  @@index([userId])
  @@index([dataType])
}

// Activity / audit log for the activity feed
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  teamId      String?
  userName    String?
  userRole    String?
  action      String   // created, updated, deleted, completed, status_changed
  entityType  String   // vehicle, delivery, maintenance, client, user
  entityId    String?
  entityName  String?
  description String
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([teamId])
  @@index([entityType])
  @@index([createdAt])
}

// Durable single-use receipt for a confirmed assistant action. The unique
// signed-preview nonce is required to make retries and concurrent submits safe.
model ActionExecution {
  id              String   @id @default(cuid())
  previewNonce    String   @unique
  ownerId         String
  teamId          String?
  proposerId      String
  confirmerId     String
  sourceFindingId String?
  actionType      String
  result          String
  createdAt       DateTime @default(now())

  @@index([ownerId, teamId, createdAt])
  @@index([proposerId, createdAt])
  @@index([confirmerId, createdAt])
  @@index([sourceFindingId])
  @@index([teamId, createdAt])
}

model DocumentUpload {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scopeKey      String
  uploadedById  String?
  uploadedBy    User?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedBySnapshot String
  originalName  String
  mimeType      String
  byteSize      Int
  contentSha256 String
  storageKey    String   @unique
  status        String   @default("UPLOADED")
  scanStatus    String
  extraction    String?
  reviewDraft   String?
  revision      Int      @default(1)
  extractedAt   DateTime?
  expiresAt     DateTime
  deletedAt     DateTime?
  cleanupToken  String?
  cleanupClaimedAt DateTime?
  processingToken String?
  processingLeaseUntil DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  executions    DocumentExecution[]
  expenses      ExpenseRecord[]

  @@unique([scopeKey, contentSha256])
  @@index([ownerId, teamId, createdAt])
  @@index([expiresAt, deletedAt])
  @@index([status, cleanupClaimedAt])
  @@index([status, processingLeaseUntil])
  @@index([uploadedById, createdAt])
}

model DocumentExecution {
  id          String   @id @default(cuid())
  documentId  String
  document    DocumentUpload @relation(fields: [documentId], references: [id], onDelete: Cascade)
  nonce       String   @unique
  confirmerId String?
  confirmer   User?    @relation("DocumentConfirmer", fields: [confirmerId], references: [id], onDelete: SetNull)
  confirmerSnapshot String
  entityId    String
  result      String
  createdAt   DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([confirmerId, createdAt])
}

model ExpenseRecord {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vendor           String
  date             DateTime
  category         String
  subtotal         Float?
  tax              Float?
  total            Float
  description      String
  sourceDocumentId String?
  sourceDocument   DocumentUpload? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId, teamId, date])
  @@index([vehicleId])
  @@index([sourceDocumentId])
}

model Announcement {
  id          String   @id @default(cuid())
  message     String
  priority    String   @default("low") // low, normal, high, urgent
  type        String   @default("general") // system, maintenance, delivery, general
  category    String?
  expiresAt   DateTime?
  actionUrl   String?
  actionLabel String?
  author      String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([teamId])
  @@index([createdAt])
}

model TaskShareLink {
  id        String    @id @default(cuid())
  token     String    @unique // sha256 hex of the share token; plaintext is never stored
  taskId    String
  task      MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  usedAt    DateTime?

  @@index([token])
  @@index([taskId])
}

model IntegrationConnection {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamId             String?
  team               Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scopeKey           String
  provider           String
  generation         Int      @default(1)
  status             String   @default("DISCONNECTED")
  credentialEnvelope String?
  scopes             String   @default("[]")
  externalAccountRef String?
  tokenExpiresAt     DateTime?
  refreshTokenExpiresAt DateTime?
  revokedAt          DateTime?
  lastSyncAt         DateTime?
  nextSyncAt         DateTime?
  lastErrorCode      String?
  syncCursor         String?
  lockToken          String?
  lockExpiresAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  oauthStates        IntegrationOAuthState[]
  syncJobs           IntegrationSyncJob[]
  records            IntegrationRecord[]

  @@unique([scopeKey, provider])
  @@index([ownerId, teamId])
  @@index([status, nextSyncAt])
}

model IntegrationOAuthState {
  id                    String   @id @default(cuid())
  connectionId          String
  connection            IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  stateDigest           String   @unique
  generation            Int
  redirectPath          String
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime @default(now())

  @@index([connectionId, expiresAt])
}

model IntegrationSyncJob {
  id             String   @id @default(cuid())
  connectionId   String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  idempotencyKey String
  generation     Int
  lockToken      String
  lockExpiresAt  DateTime
  status         String   @default("PENDING")
  cursorBefore   String?
  cursorAfter    String?
  processedCount Int      @default(0)
  errorCode      String?
  attemptCount   Int      @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  @@unique([connectionId, idempotencyKey])
  @@index([status, createdAt])
}

model IntegrationRecord {
  id             String   @id @default(cuid())
  connectionId   String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  remoteType     String
  remoteId       String
  remoteUpdatedAt DateTime?
  payloadHash    String
  reviewPayload  String?
  provenance     String
  localEntityType String?
  localEntityId  String?
  reviewStatus   String   @default("PENDING_REVIEW")
  conflictReason String?
  revision       Int      @default(1)
  outcome        String?
  attemptCount   Int      @default(0)
  nextRetryAt    DateTime?
  lastErrorCode  String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  reviews        IntegrationRecordReview[]

  @@unique([connectionId, remoteType, remoteId])
  @@index([connectionId, reviewStatus])
  @@index([localEntityType, localEntityId])
}

model IntegrationRateLimit {
  actorId     String
  scopeKey    String
  provider    String
  action      String
  bucketStart DateTime
  count       Int      @default(0)

  @@id([actorId, scopeKey, provider, action, bucketStart])
  @@index([bucketStart])
}

model IntegrationRecordReview {
  id               String   @id @default(cuid())
  recordId         String
  record           IntegrationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  revision         Int
  decision         String
  payloadHash      String
  payloadSnapshot  String
  reviewerId       String
  reviewerSnapshot String
  mappedVehicleId  String?
  createdAt        DateTime @default(now())

  @@unique([recordId, revision, decision])
  @@index([reviewerId, createdAt])
  @@index([recordId, createdAt])
}

model AiWorkspaceConfig {
  id             String   @id @default(cuid())
  scopeKey       String   @unique
  ownerId        String
  teamId         String?
  enabled        Boolean  @default(false)
  killSwitch     Boolean  @default(false)
  retentionDays  Int      @default(30)
  provider       String   @default("disabled")
  modelVersion   String   @default("none@v1")
  configVersion  Int      @default(1)
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId, teamId])
}

model AiControlAudit {
  id            String   @id @default(cuid())
  scopeKey      String
  actorId       String
  action        String
  configVersion Int
  metadata      String
  createdAt     DateTime @default(now())

  @@index([scopeKey, createdAt])
  @@index([actorId, createdAt])
  @@unique([scopeKey, configVersion])
}

model AiTelemetryBucket {
  id             String   @id @default(cuid())
  scopeKey       String
  bucketStart    DateTime
  provider       String
  modelVersion   String
  status         String
  errorCode      String   @default("")
  requestCount   Int      @default(0)
  latencyTotalMs BigInt   @default(0)
  inputTokens    BigInt   @default(0)
  outputTokens   BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scopeKey, bucketStart, provider, modelVersion, status, errorCode], map: "AiTelemetryBucket_scopeKey_bucketStart_provider_modelVersion_st")
  @@index([scopeKey, bucketStart])
}

model AiEvaluationRun {
  id                  String   @id @default(cuid())
  evaluationVersion   String
  mode                String
  configFingerprint   String
  capturedAt          DateTime
  provider            String
  modelVersion        String
  citationAccuracyBps Int
  crossTenantFailures Int
  passed               Boolean
  score                String
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([evaluationVersion, provider, modelVersion])
}

/// Singleton encrypted transactional-email configuration. The provider secret
/// is encrypted with the deployment-only EMAIL_CONFIG_ENCRYPTION_KEY and is
/// never returned from an API.
model EmailDeliveryConfig {
  id                String   @id @default("global")
  provider          String   @default("mailgun")
  apiKeyEnvelope    String
  domain            String
  verifiedDomain    String
  fromEmail         String
  configuredById    String
  configuredAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Consent and status for the limited, controlled Fleetvera pilot. This model
/// intentionally stores no operational payloads or prompts.
model PilotEnrollment {
  id                 String   @id @default(cuid())
  scopeKey           String   @unique
  ownerId            String
  teamId             String?
  status             String   @default("INVITED")
  pilotStartsAt      DateTime?
  pilotEndsAt        DateTime?
  consentedAt        DateTime?
  supportOwnerId     String?
  supportOwnerLabel  String?
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId, teamId])
  @@index([status, pilotEndsAt])
}

/// Privacy-safe adoption signals. sessionKey is an opaque client-generated
/// identifier; no prompt, page payload, or free-form content is retained.
model PilotEvent {
  id          String   @id @default(cuid())
  scopeKey    String
  ownerId     String
  teamId      String?
  actorId     String
  sessionKey  String
  eventType   String
  occurredAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([scopeKey, occurredAt])
  @@index([actorId, occurredAt])
  @@index([expiresAt])
  @@unique([scopeKey, actorId, sessionKey, eventType])
}

/// Structured, content-free support incident register for pilot exit review.
model PilotIncident {
  id          String   @id @default(cuid())
  scopeKey    String
  ownerId     String
  teamId      String?
  severity    String
  category    String
  status      String   @default("OPEN")
  occurredAt  DateTime @default(now())
  resolvedAt  DateTime?
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scopeKey, occurredAt])
  @@index([expiresAt])
}
