{
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_DB": "fleetvera_rebuild_production",
        "POSTGRES_USER": "fleetvera_owner",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?required}"
      },
      "volumes": [
        "fleetvera_rebuild_production_database_v1:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U fleetvera_owner -d fleetvera_rebuild_production"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 20
      },
      "restart": "unless-stopped"
    },
    "migrate": {
      "environment": {
        "DATABASE_URL": "${DATABASE_OWNER_URL:?required}",
        "REBUILD_DATABASE_NAME": "fleetvera_rebuild_production"
      },
      "command": [
        "node",
        "src/migrate.mjs"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "restart": "no",
      "build": {
        "context": "./replacement",
        "dockerfile": "Dockerfile",
        "target": "runtime",
        "args": {
          "SOURCE_COMMIT": "${SOURCE_COMMIT}"
        }
      }
    },
    "runtime-role": {
      "environment": {
        "PGHOST": "postgres",
        "PGDATABASE": "fleetvera_rebuild_production",
        "PGUSER": "fleetvera_owner",
        "PGPASSWORD": "${POSTGRES_PASSWORD:?required}",
        "RUNTIME_PASSWORD": "${RUNTIME_DATABASE_PASSWORD:?required}"
      },
      "tmpfs": [
        "/var/lib/postgresql/data"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "restart": "no",
      "build": {
        "context": "./replacement",
        "dockerfile": "Dockerfile",
        "target": "db-init",
        "args": {
          "SOURCE_COMMIT": "${SOURCE_COMMIT}"
        }
      }
    },
    "app": {
      "expose": [
        "3001"
      ],
      "environment": {
        "DATABASE_URL": "${DATABASE_URL:?required}",
        "REBUILD_DATABASE_NAME": "fleetvera_rebuild_production",
        "APP_ORIGIN": "${APP_ORIGIN:?required}",
        "SETUP_TOKEN": "${SETUP_TOKEN:?required}"
      },
      "depends_on": {
        "runtime-role": {
          "condition": "service_completed_successfully"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3001/api/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12
      },
      "restart": "unless-stopped",
      "build": {
        "context": "./replacement",
        "dockerfile": "Dockerfile",
        "target": "runtime",
        "args": {
          "SOURCE_COMMIT": "${SOURCE_COMMIT}"
        }
      }
    }
  },
  "volumes": {
    "fleetvera_rebuild_production_database_v1": {}
  }
}
