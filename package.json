    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^9.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "speakeasy": "^2.0.0",
