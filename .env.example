DATABASE_URL=postgresql://fleetflow:fleetflow@postgres:5432/fleetflow
JWT_SECRET=
# JSON key ring (1-3 unique secrets, each at least 32 bytes). Never reuse auth secrets.
ACTION_PREVIEW_KEYS={"current":"replace-with-openssl-rand-base64-48"}
ACTION_PREVIEW_CURRENT_KID=current
API_CURSOR_SECRET=
NEXTAUTH_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=
CRON_SECRET=
MAPBOX_ACCESS_TOKEN=

# Server-only AI configuration. Keep disabled until a provider and pinned model are explicitly configured.
AI_PROVIDER=disabled
AI_KILL_SWITCH=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_RESPONSE_BYTES=64000

# Optional ISO 4217 code (for example CAD). Cost-trend scoring stays unavailable
# unless currency context is explicitly configured.
MAINTENANCE_RISK_CURRENCY=

# Private document intelligence. Production uploads remain fail-closed until a
# MalwareScanner adapter is registered; see docs/runbooks/document-intelligence.md.
DOCUMENT_STORAGE_PATH=/var/lib/fleetvera/documents
DOCUMENT_STORAGE_PROVIDER=filesystem
DOCUMENT_STORAGE_SECRET=
DOCUMENT_SCANNER_PROVIDER=disabled
DOCUMENT_AI_PROVIDER=disabled
# Provider integrations (server-only; never prefix secrets with NEXT_PUBLIC_)
# Comma-separated AES-256-GCM keys, active key first: key-id:base64-32-byte-key
INTEGRATION_ENCRYPTION_KEYS=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://fleetvera.example/api/integrations/quickbooks/callback
QUICKBOOKS_API_BASE_URL=https://quickbooks.api.intuit.com
